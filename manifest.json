{
  "manifest_version": 3,
  "name": "P2R3 Converter Tool",
  "version": "1.1.0",
  "description": "Quickly open the P2R3 conversion tool in a new tab.",
  "action": {
    "default_title": "Open P2R3 Converter"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "permissions": [
    "tabs"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "p2r3-converter-tab@example.com",
      "strict_min_version": "109.0"
    }
  }
}
